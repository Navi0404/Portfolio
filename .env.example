# Copy to .env for local dev (.env is git-ignored). In production, set these in
# Vercel → Project → Settings → Environment Variables instead.
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=gpt-oss:120b
# Optional: defaults to Ollama Cloud. Use your own server URL if you self-host.
OLLAMA_HOST=https://ollama.com
